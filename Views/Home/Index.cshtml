@{
    ViewData["Title"] = "Nexo ERP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nexo ERP | Gestão Inteligente by Konvex Jr</title>

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #0F172A;
            --primary-light: #1E293B;
            --accent: #3B82F6;
            --accent-hover: #2563EB;
            --secondary: #8B5CF6;
            --success: #10B981;
            --bg-light: #F8FAFC;
            --text-dark: #0F172A;
            --text-muted: #64748B;
            --border: #E2E8F0;
            --gradient-1: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --gradient-2: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
            --gradient-3: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--text-dark);
            background: white;
            overflow-x: hidden;
        }

        /* NAVBAR */
        .navbar {
            backdrop-filter: blur(20px);
            background: rgba(255,255,255,.95);
            box-shadow: 0 1px 3px rgba(0,0,0,.05);
            padding: 1rem 0;
            transition: all .3s ease;
        }

        .navbar.scrolled {
            box-shadow: 0 4px 24px rgba(0,0,0,.08);
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--primary);
            display: flex;
            gap: .75rem;
            align-items: center;
            letter-spacing: -0.5px;
        }

        .brand-logo {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: var(--gradient-2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 900;
            font-size: 1.3rem;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }

        .nav-link {
            color: var(--text-dark);
            font-weight: 600;
            padding: .5rem 1rem !important;
            transition: color .3s;
            font-size: .95rem;
        }

        .nav-link:hover {
            color: var(--accent);
        }

        .btn-login {
            border: 2px solid var(--primary);
            border-radius: 12px;
            padding: .6rem 1.5rem;
            font-weight: 700;
            color: var(--primary);
            transition: all .3s;
            font-size: .95rem;
        }

        .btn-login:hover {
            background: var(--primary);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.2);
        }

        /* HERO */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            background: linear-gradient(180deg, #F8FAFC 0%, #ffffff 100%);
            position: relative;
            overflow: hidden;
            padding: 140px 0 100px;
        }

        .hero::before {
            content: "";
            position: absolute;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(59,130,246,0.1) 0%, transparent 70%);
            top: -200px;
            right: -200px;
            animation: float 20s ease-in-out infinite;
        }

        .hero::after {
            content: "";
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(139,92,246,0.08) 0%, transparent 70%);
            bottom: -150px;
            left: -150px;
            animation: float 15s ease-in-out infinite reverse;
        }

        @@keyframes float {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            33% { transform: translate(30px, -30px) rotate(5deg); }
            66% { transform: translate(-20px, 20px) rotate(-5deg); }
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(59, 130, 246, 0.1);
            color: var(--accent);
            padding: .5rem 1.2rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: .85rem;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }

        .hero h1 {
            font-size: 4rem;
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -2px;
            margin-bottom: 1.5rem;
        }

        .hero h1 .gradient-text {
            background: var(--gradient-2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-description {
            font-size: 1.25rem;
            color: var(--text-muted);
            line-height: 1.8;
            max-width: 600px;
            margin-bottom: 2.5rem;
        }

        .hero-cta {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn-hero-primary {
            background: var(--gradient-2);
            border: none;
            border-radius: 14px;
            padding: 1rem 2.5rem;
            font-weight: 700;
            color: #fff;
            font-size: 1.05rem;
            transition: all .3s;
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.3);
        }

        .btn-hero-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(59, 130, 246, 0.4);
        }

        .btn-hero-secondary {
            background: white;
            border: 2px solid var(--border);
            border-radius: 14px;
            padding: 1rem 2rem;
            font-weight: 700;
            color: var(--primary);
            font-size: 1.05rem;
            transition: all .3s;
        }

        .btn-hero-secondary:hover {
            border-color: var(--accent);
            color: var(--accent);
            transform: translateY(-3px);
        }

        .hero-image {
            position: relative;
            z-index: 2;
        }

        .hero-mockup {
            width: 100%;
            max-width: 650px;
            border-radius: 24px;
            box-shadow: 0 30px 80px rgba(0,0,0,.15);
            animation: floatMockup 6s ease-in-out infinite;
        }

        @@keyframes floatMockup {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        .floating-card {
            position: absolute;
            background: white;
            border-radius: 16px;
            padding: 1.2rem;
            box-shadow: 0 20px 50px rgba(0,0,0,.1);
            animation: floatCard 4s ease-in-out infinite;
        }

        @@keyframes floatCard {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
        }

        .card-1 {
            top: 10%;
            left: -5%;
            animation-delay: 0s;
        }

        .card-2 {
            bottom: 15%;
            right: -5%;
            animation-delay: 1s;
        }

        .floating-card i {
            font-size: 2rem;
            color: var(--accent);
        }

        .floating-card h6 {
            margin: .8rem 0 .3rem;
            font-weight: 700;
            font-size: .9rem;
        }

        .floating-card p {
            margin: 0;
            font-size: .75rem;
            color: var(--text-muted);
        }

        /* STATS */
        .stats {
            background: var(--primary);
            padding: 4rem 0;
            position: relative;
            overflow: hidden;
        }

        .stats::before {
            content: "";
            position: absolute;
            width: 100%;
            height: 100%;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            opacity: .3;
        }

        .stat-item {
            text-align: center;
            position: relative;
            z-index: 2;
        }

        .stat-number {
            font-size: 3rem;
            font-weight: 800;
            color: white;
            margin-bottom: .5rem;
        }

        .stat-label {
            color: rgba(255,255,255,.8);
            font-size: 1rem;
            font-weight: 600;
        }

        /* FEATURES */
        .features {
            padding: 100px 0;
            background: white;
        }

        .section-header {
            text-align: center;
            margin-bottom: 5rem;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
        }

        .section-badge {
            display: inline-block;
            background: rgba(139, 92, 246, 0.1);
            color: var(--secondary);
            padding: .5rem 1.2rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: .85rem;
            margin-bottom: 1rem;
        }

        .section-title {
            font-size: 2.8rem;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 1rem;
        }

        .section-description {
            font-size: 1.15rem;
            color: var(--text-muted);
            line-height: 1.8;
        }

        .feature-card {
            background: white;
            border: 2px solid var(--border);
            border-radius: 24px;
            padding: 2.5rem;
            height: 100%;
            transition: all .3s ease;
            position: relative;
            overflow: hidden;
        }

        .feature-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--gradient-2);
            transform: scaleX(0);
            transition: transform .3s ease;
        }

        .feature-card:hover {
            border-color: var(--accent);
            transform: translateY(-8px);
            box-shadow: 0 20px 50px rgba(0,0,0,.08);
        }

        .feature-card:hover::before {
            transform: scaleX(1);
        }

        .feature-icon {
            width: 70px;
            height: 70px;
            border-radius: 18px;
            background: var(--gradient-2);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.25);
        }

        .feature-icon i {
            font-size: 2rem;
            color: white;
        }

        .feature-card h5 {
            font-weight: 800;
            font-size: 1.3rem;
            margin-bottom: 1rem;
            letter-spacing: -0.5px;
        }

        .feature-card p {
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 0;
        }

        /* SHOWCASE */
        .showcase {
            padding: 100px 0;
            background: var(--bg-light);
        }

        .showcase-item {
            margin-bottom: 6rem;
        }

        .showcase-content h3 {
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 1.5rem;
        }

        .showcase-content p {
            font-size: 1.1rem;
            color: var(--text-muted);
            line-height: 1.8;
            margin-bottom: 2rem;
        }

        .showcase-list {
            list-style: none;
            padding: 0;
        }

        .showcase-list li {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .showcase-list i {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--gradient-2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: .9rem;
        }

        .showcase-image {
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 30px 80px rgba(0,0,0,.12);
        }

        .showcase-image img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* CTA */
        .cta-section {
            padding: 100px 0;
            background: var(--gradient-2);
            position: relative;
            overflow: hidden;
        }

        .cta-section::before {
            content: "";
            position: absolute;
            width: 100%;
            height: 100%;
            background: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23ffffff' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
        }

        .cta-content {
            text-align: center;
            color: white;
            position: relative;
            z-index: 2;
        }

        .cta-content h2 {
            font-size: 3rem;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 1.5rem;
        }

        .cta-content p {
            font-size: 1.25rem;
            opacity: .95;
            margin-bottom: 3rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .btn-cta {
            background: white;
            color: var(--accent);
            border: none;
            border-radius: 14px;
            padding: 1.2rem 3rem;
            font-weight: 800;
            font-size: 1.1rem;
            transition: all .3s;
            box-shadow: 0 10px 30px rgba(0,0,0,.2);
        }

        .btn-cta:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(0,0,0,.3);
            color: var(--accent-hover);
        }

        /* FOOTER */
        footer {
            background: var(--primary);
            color: white;
            padding: 5rem 0 2rem;
        }

        .footer-brand {
            margin-bottom: 1.5rem;
        }

        .footer-logo {
            display: flex;
            align-items: center;
            gap: .75rem;
            margin-bottom: 1rem;
        }

        .footer-logo-icon {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            background: var(--gradient-2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 1.4rem;
        }

        .footer-logo-text {
            font-size: 1.5rem;
            font-weight: 800;
        }

        .footer-description {
            color: rgba(255,255,255,.7);
            line-height: 1.7;
            margin-bottom: 1.5rem;
        }

        .footer-social {
            display: flex;
            gap: .75rem;
        }

        .social-link {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: rgba(255,255,255,.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            transition: all .3s;
        }

        .social-link:hover {
            background: var(--accent);
            transform: translateY(-3px);
        }

        .footer-title {
            font-weight: 800;
            font-size: 1rem;
            margin-bottom: 1.5rem;
            color: white;
        }

        .footer-links {
            list-style: none;
            padding: 0;
        }

        .footer-links li {
            margin-bottom: .75rem;
        }

        .footer-links a {
            color: rgba(255,255,255,.7);
            text-decoration: none;
            transition: all .3s;
            font-weight: 500;
        }

        .footer-links a:hover {
            color: var(--accent);
            padding-left: 5px;
        }

        .footer-bottom {
            margin-top: 4rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(255,255,255,.1);
            text-align: center;
            color: rgba(255,255,255,.6);
        }

        .konvex-badge {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: rgba(255,255,255,.1);
            padding: .5rem 1rem;
            border-radius: 50px;
            margin-top: 1rem;
            font-weight: 600;
            color: rgba(255,255,255,.9);
        }

        /* RESPONSIVE */
        @@media (max-width: 992px) {
            .hero h1 {
                font-size: 2.8rem;
            }

            .hero-mockup {
                max-width: 100%;
                margin-top: 3rem;
            }

            .floating-card {
                display: none;
            }

            .section-title {
                font-size: 2.2rem;
            }

            .cta-content h2 {
                font-size: 2.2rem;
            }
        }

        @@media (max-width: 768px) {
            .hero h1 {
                font-size: 2.2rem;
            }

            .hero-description {
                font-size: 1.05rem;
            }

            .hero-cta {
                flex-direction: column;
            }

            .btn-hero-primary,
            .btn-hero-secondary {
                width: 100%;
                text-align: center;
            }

            .stat-number {
                font-size: 2.2rem;
            }
        }
    </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="#">
            <div class="brand-logo">N</div>
            Nexo ERP
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav ms-auto align-items-center gap-3">
                <li class="nav-item"><a class="nav-link" href="#beneficios">Benefícios</a></li>
                <li class="nav-item"><a class="nav-link" href="#recursos">Recursos</a></li>
                <li class="nav-item"><a class="nav-link" href="#contato">Contato</a></li>
                <li class="nav-item">
                    <a href="@Url.Action("Login","Usuario")" class="btn btn-login">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Login
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- HERO -->
<section class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <div class="hero-content">
                    <span class="hero-badge">
                        <i class="bi bi-lightning-charge-fill me-1"></i>
                        Powered by Konvex Jr
                    </span>
                    <h1>
                        Gestão inteligente.<br>
                        <span class="gradient-text">Decisões melhores.</span>
                    </h1>
                    <p class="hero-description">
                        O <strong>Nexo ERP</strong> conecta financeiro, operações e pessoas em uma única plataforma 
                        simples, segura e eficiente. Transforme dados em insights e impulsione seu crescimento.
                    </p>
                    <div class="hero-cta">
                        <a href="#contato" class="btn btn-hero-primary">
                            <i class="bi bi-rocket-takeoff-fill me-2"></i>
                            Começar Agora
                        </a>
                        <a href="https://wa.me/47988765799" class="btn btn-hero-secondary">
                            <i class="bi bi-play-circle-fill me-2"></i>
                            Agendar Demonstração
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6" data-aos="fade-left" data-aos-delay="200">
                <div class="hero-image">
                    <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1200&h=800&fit=crop&q=80" 
                         alt="Dashboard Nexo ERP" 
                         class="hero-mockup">
                    
                    <div class="floating-card card-1" data-aos="fade-up" data-aos-delay="400">
                        <i class="bi bi-graph-up-arrow"></i>
                        <h6>+127% Produtividade</h6>
                        <p>Processos automatizados</p>
                    </div>

                    <div class="floating-card card-2" data-aos="fade-up" data-aos-delay="600">
                        <i class="bi bi-shield-check"></i>
                        <h6>100% Seguro</h6>
                        <p>Dados protegidos</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- STATS -->
<section class="stats">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-4" data-aos="fade-up">
                <div class="stat-item">
                    <div class="stat-number">200+</div>
                    <div class="stat-label">Clientes Satisfeitos</div>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
