@{
    ViewData["Title"] = "Nexo ERP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nexo ERP | Gestão Inteligente by Konvex</title>

    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        :root {
            --primary: #1E4D5C;
            --secondary: #7EC8E3;
            --accent: #FF6B4A;
            --bg-light: #F6F9FC;
            --text-dark: #0F172A;
            --text-muted: #64748B;
            --gradient: linear-gradient(135deg, #1E4D5C, #7EC8E3);
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: var(--text-dark);
            background: white;
        }

        /* NAVBAR */
        .navbar {
            backdrop-filter: blur(10px);
            background: rgba(255,255,255,.9);
            box-shadow: 0 2px 20px rgba(0,0,0,.08);
        }

        .navbar-brand {
            font-weight: 800;
            color: var(--primary);
            display: flex;
            gap: .6rem;
            align-items: center;
        }

        .brand-badge {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 900;
        }

        .nav-link {
            color: var(--text-dark);
            font-weight: 500;
        }

        .btn-outline {
            border: 1.5px solid var(--primary);
            border-radius: 999px;
            padding: .45rem 1.2rem;
            font-weight: 600;
            color: var(--primary);
        }

        .btn-outline:hover {
            background: var(--primary);
            color: #fff;
        }

        .btn-primary-gradient {
            background: var(--gradient);
            border: none;
            border-radius: 999px;
            padding: .5rem 1.4rem;
            font-weight: 600;
            color: #fff;
        }

        /* HERO */
        .hero {
            padding: 110px 0 90px;
            background: var(--bg-light);
            position: relative;
            overflow: hidden;
        }

        .hero::after {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            background: rgba(126,200,227,.25);
            border-radius: 50%;
            top: -150px;
            right: -150px;
            filter: blur(120px);
        }

        .hero h1 {
            font-size: 3.2rem;
            font-weight: 900;
        }

        .hero p {
            font-size: 1.2rem;
            color: var(--text-muted);
            max-width: 520px;
        }

        .hero-cta {
            margin-top: 2rem;
        }

        .hero-card {
            background: #fff;
            border-radius: 24px;
            padding: 2.5rem;
            box-shadow: 0 30px 80px rgba(0,0,0,.08);
        }

        /* SECTIONS */
        section {
            padding: 90px 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: 4rem;
        }

        .section-title h2 {
            font-weight: 800;
            font-size: 2.5rem;
        }

        .section-title p {
            color: var(--text-muted);
            font-size: 1.1rem;
        }

        /* FEATURES */
        .feature {
            padding: 2rem;
            border-radius: 20px;
            background: #fff;
            height: 100%;
            transition: .3s;
            box-shadow: 0 10px 30px rgba(0,0,0,.05);
        }

        .feature:hover {
            transform: translateY(-8px);
        }

        .feature i {
            font-size: 2.2rem;
            color: var(--accent);
        }

        .feature h5 {
            margin-top: 1rem;
            font-weight: 700;
        }

        .feature p {
            color: var(--text-muted);
        }

        /* CTA */
        .cta {
            background: var(--gradient);
            color: #fff;
            text-align: center;
            padding: 90px 0;
        }

        .cta h2 {
            font-weight: 900;
        }

        .cta p {
            opacity: .95;
            font-size: 1.2rem;
        }

        /* FOOTER */
        footer {
            background: #0B2C36;
            color: #fff;
            padding: 4rem 0 2rem;
        }

        footer h6 {
            font-weight: 700;
            color: var(--accent);
        }

        footer a {
            color: rgba(255,255,255,.75);
            text-decoration: none;
        }

        footer a:hover {
            color: var(--accent);
        }

        @@media (max-width: 768px) {
            .hero h1 {
                font-size: 2.3rem;
            }
        }
    </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
        <a class="navbar-brand" href="#">
            <div class="brand-badge">N</div>
            Nexo ERP
        </a>
        <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav ms-auto align-items-center gap-2">
                <li class="nav-item"><a class="nav-link" href="#beneficios">Benefícios</a></li>
                <li class="nav-item"><a class="nav-link" href="#contato">Contato</a></li>
                <li class="nav-item">
                    <a href="@Url.Action("Login","Usuario")" class="btn btn-outline">
                        Login
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- HERO -->
<section class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <h1>Gestão inteligente.<br>Decisões melhores.</h1>
                <p>
                    O <strong>Nexo ERP</strong> conecta financeiro, operações e pessoas
                    em uma única plataforma simples, segura e eficiente.
                </p>
            </div>

            <div class="col-lg-6" data-aos="fade-left">
                <div class="hero-card">
                    <i class="bi bi-diagram-3" style="font-size:4rem;color:var(--primary)"></i>
                    <h5 class="mt-3">Tudo conectado</h5>
                    <p class="text-muted">
                        Centralize dados, automatize processos e tenha controle total do seu negócio.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FEATURES -->
<section id="beneficios">
    <div class="container">
        <div class="section-title" data-aos="fade-up">
            <h2>Por que usar o Nexo?</h2>
            <p>Um ERP moderno, feito para crescer com você</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up">
                <div class="feature">
                    <i class="bi bi-speedometer2"></i>
                    <h5>Produtividade</h5>
                    <p>Menos tarefas manuais, mais foco no que importa.</p>
                </div>
            </div>

            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="feature">
                    <i class="bi bi-shield-lock"></i>
                    <h5>Segurança</h5>
                    <p>Controle de acesso, rastreabilidade e proteção de dados.</p>
                </div>
            </div>

            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="feature">
                    <i class="bi bi-graph-up"></i>
                    <h5>Visão Estratégica</h5>
                    <p>Relatórios claros para decisões mais inteligentes.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta" id="contato">
    <div class="container" data-aos="zoom-in">
        <h2>Leve sua gestão para o próximo nível</h2>
        <p>Desenvolvido pela Konvex Jr, com foco em eficiência e inovação.</p>

        <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
            <a href="https://wa.me/5547988765799" target="_blank" class="btn btn-success btn-lg">
                <i class="bi bi-whatsapp me-2"></i> Falar com Especialista
            </a>
        </div>
    </div>
</section>

<!-- FOOTER -->
<footer>
    <div class="container">
        <div class="row gy-4">
            <div class="col-md-4">
                <h6>Nexo ERP</h6>
                <p class="opacity-75">
                    Sistema de gestão empresarial desenvolvido pela Konvex Jr.
                </p>
            </div>
            <div class="col-md-4">
                <h6>Links</h6>
                <a href="#beneficios">Benefícios</a><br>
                <a href="@Url.Action("Login","Usuario")">Login</a><br>
            </div>
            <div class="col-md-4">
                <h6>Contato</h6>
                <p class="opacity-75">
                    <i class="bi bi-envelope"></i> contato@konvexjr.com.br<br>
                    <i class="bi bi-geo-alt"></i> Joinville - SC
                </p>
            </div>
        </div>

        <hr class="my-4 opacity-25">
        <p class="text-center opacity-75 mb-0">
            © 2026 Nexo ERP — by Konvex Jr
        </p>
    </div>
</footer>

<!-- JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({
        duration: 900,
        once: true,
        offset: 120
    });
</script>

</body>
</html>
